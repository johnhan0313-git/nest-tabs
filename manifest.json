{
  "manifest_version": 3,
  "name": "Nest Tabs",
  "version": "1.2.12",
  "minimum_chrome_version": "116",
  "description": "Organize tabs into nestable folders with custom names. Tabs not in a folder auto-close after a set time.",
  "permissions": ["sidePanel", "tabs", "tabGroups", "storage", "alarms", "history", "favicon", "webNavigation"],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "action": {
    "default_title": "Nest Tabs",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png"
    }
  },
  "options_page": "options.html",
  "side_panel": {
    "default_path": "sidepanel.html"
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
